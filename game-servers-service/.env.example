# ================================
# Game Servers Service
# Environment Configuration Template
# ================================
# Copy this file to .env and update the values

# Application Settings
NODE_ENV=development
# Changed to 3001 so it doesn't conflict with main backend
PORT=3001
CORS_ORIGIN=*

# ================================
# Internal Hook Auth
# ================================
# Shared with Nakama and spawned Unity match servers
INTERNAL_HOOK_SECRET="replace_with_nakama_hook_key"

# ================================
# Dedicated Match Server Configuration
# ================================
# Docker image for the Unity headless server spawned per match
# Example: ghcr.io/your-org/repunity-server:latest
GAME_SERVER_IMAGE='unity-server:latest'
GAME_SERVER_DOCKER_NETWORK=game-net
GAME_SERVER_PORT_START=7900
GAME_SERVER_PORT_END=8900
GAME_SERVER_MEMORY_LIMIT=150m
GAME_SERVER_CPU_LIMIT=0.2
GAME_SERVER_INTERNAL_PORT=7778
# Unity headless servers can take longer to initialize under load.
GAME_SERVER_BOOT_TIMEOUT_SECONDS=60
GAME_SERVER_CLEANUP_INTERVAL_SECONDS=30
GAME_SERVER_MAX_LIFETIME_MINUTES=30
GAME_SERVER_ROUTER_PORT=4000
