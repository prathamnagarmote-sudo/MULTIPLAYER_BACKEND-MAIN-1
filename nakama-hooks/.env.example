# Custom Nakama image published by GitHub Actions
NAKAMA_IMAGE=ghcr.io/<owner>/nakama-custom:<sha-or-latest>

# PostgreSQL runtime values used by the compose stack
POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=localdb

# Hook-to-backend settings
GAME_SERVERS_URL=http://game-servers-service:3000
INTERNAL_HOOK_SECRET=replace-with-a-strong-secret